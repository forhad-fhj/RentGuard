# Application
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# Database
DATABASE_URL=postgresql://rentguard:changeme@localhost:5432/rentguard_db?schema=public

# Redis
REDIS_URL=redis://localhost:6379
REDIS_TTL=3600

# JWT Authentication
JWT_SECRET=changeme-super-secret-jwt-key-min-32-chars
JWT_REFRESH_SECRET=changeme-super-secret-refresh-key-min-32-chars
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Encryption
ENCRYPTION_KEY=changeme-32-char-encryption-key-here
ENCRYPTION_ALGORITHM=aes-256-gcm

# AWS S3
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=changeme
AWS_SECRET_ACCESS_KEY=changeme
AWS_S3_BUCKET=rentguard-documents
AWS_S3_ENDPOINT=

# Kafka
KAFKA_BROKER=localhost:9092
KAFKA_CLIENT_ID=rentguard-backend
KAFKA_GROUP_ID=rentguard-consumer-group

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=changeme@gmail.com
SMTP_PASS=changeme
SMTP_FROM=noreply@rentguard.bd

# SMS (Twilio)
TWILIO_ACCOUNT_SID=changeme
TWILIO_AUTH_TOKEN=changeme
TWILIO_PHONE_NUMBER=+1234567890

# Payment Gateways
BKASH_API_KEY=changeme
BKASH_API_SECRET=changeme
BKASH_MERCHANT_ID=changeme
NAGAD_API_KEY=changeme
NAGAD_API_SECRET=changeme
NAGAD_MERCHANT_ID=changeme

# Security
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
CORS_ORIGIN=http://localhost:3000

# Monitoring
SENTRY_DSN=changeme
LOG_LEVEL=debug

# OCR & AI
TESSERACT_DATA_PATH=./tesseract-data
FACE_RECOGNITION_MODEL_PATH=./models
FACE_MATCH_THRESHOLD=0.6

# Credit Score
CREDIT_SCORE_MIN=0
CREDIT_SCORE_MAX=1000
CREDIT_SCORE_DEFAULT=500

# Fraud Detection
FRAUD_DETECTION_ENABLED=true
FRAUD_RISK_THRESHOLD=0.7

# Admin
ADMIN_EMAIL=admin@rentguard.bd
ADMIN_PASSWORD=changeme
