# Example secrets file - DO NOT commit actual secrets
# Create actual secrets using: kubectl create secret generic rentguard-secrets --from-literal=database-url=... --from-literal=jwt-secret=...

apiVersion: v1
kind: Secret
metadata:
  name: rentguard-secrets
type: Opaque
stringData:
  database-url: "postgresql://user:password@host:5432/rentguard_db"
  redis-url: "redis://host:6379"
  jwt-secret: "your-secret-key-here"
  jwt-refresh-secret: "your-refresh-secret-here"
  encryption-key: "your-encryption-key-here"
  aws-access-key-id: "your-aws-access-key"
  aws-secret-access-key: "your-aws-secret-key"
